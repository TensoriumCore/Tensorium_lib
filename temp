
				__attribute__((always_inline, hot, flatten))
					inline Matrix<K> inverse() const {
						if (rows != cols)
							throw std::invalid_argument("Matrix must be square");

						const auto n = rows;
						Matrix<K> M(n, n);
						Matrix<K> Inv(n, n);

						for (auto i = decltype(n)(0); i < n; ++i) {
							for (auto j = decltype(n)(0); j < n; ++j) {
								M(i, j) = operator()(i, j);
								Inv(i, j) = (i == j) ? K(1) : K(0);
							}
						}

						using SimdT = simd::SimdTraits<K, DefaultISA>;
						using regT  = typename SimdT::reg;
						const auto W = SimdT::width;

						for (auto i = decltype(n)(0); i < n; ++i) {
							auto piv = i;
							auto maxv = std::abs(M(i, i));
							for (auto r = i + 1; r < n; ++r) {
								auto v = std::abs(M(r, i));
								if (v > maxv) 
									maxv = v; piv = r;
							}
							if (maxv < static_cast<K>(1e-12))
								throw std::runtime_error("Matrix is singular or nearly singular.");

							if (piv != i) {
								M.swap_rows(i, piv);
								Inv.swap_rows(i, piv);
							}

							auto diag = M(i, i);
							auto diag_inv = K(1) / diag;
							for (auto j = 0u; j < n; ++j) {
								M(i, j) *= diag_inv;
								Inv(i, j) *= diag_inv;
							}

#pragma omp parallel for schedule(dynamic, UNROLL)
							for (auto j = 0u; j < n; ++j) {
								if (j != i) {
									auto f = M(j, i);
									for (auto k = 0u; k < n; ++k) {
										M(j, k) -= f * M(i, k);
										Inv(j, k) -= f * Inv(i, k);
									}
								}
							}
						}

						return Inv;
					}
